@PACKAGE_INIT@

# pugixml and miniz are built into libcPMML whether it is shared or static (in
# the static case their object files are folded into the archive) and Eigen is
# header-only, so none of them is looked for here. A static archive cannot carry
# the OpenMP runtime, so a static build that used it has the consumer find it.
include(CMakeFindDependencyMacro)
if(@CPMML_FIND_OPENMP@)
    find_dependency(OpenMP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cPMMLTargets.cmake")

check_required_components(cPMML)
