<?xml version="1.0"?>
<PMML xmlns="http://www.dmg.org/PMML-4_4" version="4.4"><Header/>
<DataDictionary>
<DataField name="s" optype="categorical" dataType="string"/>
<DataField name="f" optype="continuous" dataType="float"/>
