</DataDictionary>
<TransformationDictionary>
<DerivedField name="di" optype="continuous" dataType="integer"><Apply function="*"><FieldRef field="d"/><Constant dataType="double">1</Constant></Apply></DerivedField>
</TransformationDictionary>
<RegressionModel functionName="regression">
<MiningSchema><MiningField name="s"/><MiningField name="f"/><MiningField name="i"/><MiningField name="d"/><MiningField name="b"/><MiningField name="y" usageType="target"/></MiningSchema>
<Output><OutputField name="eq_s_i" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><FieldRef field="s"/><Constant dataType="integer">3</Constant></Apply></OutputField><OutputField name="eq_i_s" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><Constant dataType="integer">3</Constant><FieldRef field="s"/></Apply></OutputField><OutputField name="eq_s_d" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><FieldRef field="s"/><Constant dataType="double">3</Constant></Apply></OutputField><OutputField name="eq_d_s" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><Constant dataType="double">3</Constant><FieldRef field="s"/></Apply></OutputField><OutputField name="eq_f_d" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><FieldRef field="f"/><Constant dataType="double">0.1</Constant></Apply></OutputField><OutputField name="eq_d_f" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><Constant dataType="double">0.1</Constant><FieldRef field="f"/></Apply></OutputField><OutputField name="le_f_d" optype="categorical" dataType="string" feature="transformedValue"><Apply function="lessOrEqual" invalidValueTreatment="asMissing"><FieldRef field="f"/><Constant dataType="double">0.1</Constant></Apply></OutputField><OutputField name="ge_d_f" optype="categorical" dataType="string" feature="transformedValue"><Apply function="greaterOrEqual" invalidValueTreatment="asMissing"><Constant dataType="double">0.1</Constant><FieldRef field="f"/></Apply></OutputField><OutputField name="lt_s_i" optype="categorical" dataType="string" feature="transformedValue"><Apply function="lessThan" invalidValueTreatment="asMissing"><FieldRef field="s"/><Constant dataType="integer">10</Constant></Apply></OutputField><OutputField name="gt_i_s" optype="categorical" dataType="string" feature="transformedValue"><Apply function="greaterThan" invalidValueTreatment="asMissing"><Constant dataType="integer">10</Constant><FieldRef field="s"/></Apply></OutputField><OutputField name="eq_b_i" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><FieldRef field="b"/><Constant dataType="integer">1</Constant></Apply></OutputField><OutputField name="eq_i_b" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><Constant dataType="integer">1</Constant><FieldRef field="b"/></Apply></OutputField><OutputField name="eq_i_d" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><FieldRef field="i"/><Constant dataType="double">3.5</Constant></Apply></OutputField><OutputField name="eq_d_i" optype="categorical" dataType="string" feature="transformedValue"><Apply function="equal" invalidValueTreatment="asMissing"><Constant dataType="double">3.5</Constant><FieldRef field="i"/></Apply></OutputField><OutputField name="plus_s_i" optype="categorical" dataType="string" feature="transformedValue"><Apply function="+" invalidValueTreatment="asMissing"><FieldRef field="s"/><Constant dataType="integer">1</Constant></Apply></OutputField><OutputField name="div_0_0" optype="categorical" dataType="string" feature="transformedValue"><Apply function="/" invalidValueTreatment="asMissing"><Constant dataType="double">0</Constant><Constant dataType="double">0</Constant></Apply></OutputField><OutputField name="idiv_0_0" optype="categorical" dataType="string" feature="transformedValue"><Apply function="/" invalidValueTreatment="asMissing"><Constant dataType="integer">0</Constant><Constant dataType="integer">0</Constant></Apply></OutputField><OutputField name="idiv_1_0" optype="categorical" dataType="string" feature="transformedValue"><Apply function="/" invalidValueTreatment="asMissing"><Constant dataType="integer">1</Constant><Constant dataType="integer">0</Constant></Apply></OutputField><OutputField name="if_miss" optype="categorical" dataType="string" feature="transformedValue"><Apply function="if"><FieldRef field="b"/><Constant dataType="string">T</Constant><Constant dataType="string">E</Constant></Apply></OutputField><OutputField name="if_miss_map" optype="categorical" dataType="string" feature="transformedValue"><Apply function="if" mapMissingTo="M"><FieldRef field="b"/><Constant dataType="string">T</Constant><Constant dataType="string">E</Constant></Apply></OutputField><OutputField name="floor_inf" optype="continuous" dataType="string" feature="transformedValue"><Apply function="floor" invalidValueTreatment="asMissing"><Constant dataType="double">INF</Constant></Apply></OutputField><OutputField name="up_s" optype="categorical" dataType="string" feature="transformedValue"><Apply function="uppercase"><FieldRef field="s"/></Apply></OutputField><OutputField name="dint" optype="continuous" dataType="string" feature="transformedValue"><FieldRef field="di"/></OutputField></Output>
<RegressionTable intercept="0"/>
</RegressionModel></PMML>